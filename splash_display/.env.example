# splash_display/.env.example - the splash's own settings for one box.
#
# Copy it to splash_display/.env (git-ignored) only if this box needs one: on
# DevPi, where the splash and pi5 run together, the defaults are right and no
# file is needed. The splash reads it at start (splash_display/config.py); a
# variable already set in the environment wins.

# Where pi5 answers. Default http://localhost:5000 (the same box). A splash on
# another machine:
# DDM_PI5_URL=http://joeydevpi.local:5000

# The board's look on this box: dots (the default), numbers or impact.
# DDM_QUINIELA_LOOK=dots
