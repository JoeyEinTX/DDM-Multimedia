# pi5/.env.example - every setting pi5 reads from pi5/.env.
#
# Copy it to pi5/.env (git-ignored) and fill in this box's values:
#   cp pi5/.env.example pi5/.env
# pi5 reads pi5/.env at start (pi5/config.py), and so does its service. A
# variable already set in the environment wins over this file. One NAME=value
# per line; quotes optional; a line starting with # is a comment.
#
# Nothing secret and nothing that belongs to one box goes in a tracked file:
# the repo is public. pi5/tools/env_from_config.py moves the values of an old,
# locally edited pi5/config.py into pi5/.env.
#
# deploy/install_services.sh checks this file: each setting below marked
# "the night needs it" that is empty is a WARN line.

# ---------------------------------------------------------------------------
# Secrets. Empty = the feature they feed is off; pi5 says so once at start.
# ---------------------------------------------------------------------------

# WeatherAPI.com key: the dashboard's weather panel and the TV crawl's weather
# line. From your account at weatherapi.com. The night needs it.
DDM_WEATHER_API_KEY=

# Anthropic API key for the track's odds poller (la_quiniela/odds.py; started
# by hand, RACE_NIGHT.md appendix). An unprefixed ANTHROPIC_API_KEY works too.
DDM_ANTHROPIC_API_KEY=

# Flask's own secret key. Leave empty: a new random one each start (nothing
# pi5 runs keeps a session).
DDM_FLASK_SECRET_KEY=

# The host's PIN for La Subasta's admin page (/la-subasta/admin) and its
# /api/admin routes. The iPad asks for it once and remembers it for 30 days;
# a guest's phone, which is on the same Wi-Fi, cannot open, lock or settle the
# auction without it. Choose your own, and change it here (then restart pi5)
# if you forget it or it gets out. Empty = those pages are off. The night
# needs it.
DDM_LS_ADMIN_PIN=change-me

# ---------------------------------------------------------------------------
# DevPi's own settings: what only this box knows.
# ---------------------------------------------------------------------------

# The gateway's USB serial port. On DevPi always the /dev/serial/by-id/... path
# (ls -l /dev/serial/by-id/), never /dev/ttyUSB0. Empty = the bridge idles: no
# cups. The night needs it.
DDM_LQ_SERIAL_PORT=

# The LED controller on the mantle (the ESP32 at TCP 5005). Empty = no LED
# controller: the LEDs are off, everything else runs. The Control Center's
# device panel writes this line when you change the address there. The night
# needs it.
DDM_ESP32_IP=
# DDM_ESP32_PORT=5005

# The tote board (Interstate75 LED display). Empty = no tote board.
DDM_TOTE_IP=
# DDM_TOTE_PORT=80
# DDM_TOTE_ENABLED=1          # defaults to on when DDM_TOTE_IP is set

# Where the weather is for.
# DDM_WEATHER_LOCATION=Dallas,TX

# The menu's "La Quiniela Board" link, when the splash runs on another machine
# ({host} is the host name the dashboard was opened with).
# DDM_SPLASH_BOARD_URL=http://{host}:5001/

# pi5's own web server.
# DDM_FLASK_HOST=0.0.0.0
# DDM_FLASK_PORT=5000

# ---------------------------------------------------------------------------
# Tuning. The defaults are right; set one only to change it.
# ---------------------------------------------------------------------------

# The gateway bridge (pi5/LQ_BRIDGE.md).
# DDM_LQ_BRIDGE_ENABLED=1
# DDM_LQ_SERIAL_BAUD=115200
# DDM_LQ_SERIAL_LINES=leave   # leave = never touch DTR/RTS (right for the CP2102 gateway); low reboots that board
# DDM_LQ_HEARTBEAT_LOG_S=10
# DDM_LQ_CUP_OFFLINE_S=6
# DDM_LQ_GATEWAY_OFFLINE_S=12
# DDM_LQ_DEAF_REOPEN_S=20
# DDM_LQ_REOPEN_MIN_GAP_S=30

# The betting board (pi5/LQ_BRIDGE.md, "Betting board"). These change the money.
# DDM_TOKEN_VALUE=1.0
# DDM_LQ_SPLIT_WIN=0.60
# DDM_LQ_SPLIT_PLACE=0.25
# DDM_LQ_SPLIT_SHOW=0.15
# DDM_QUINIELA_LOG=1
# DDM_QUINIELA_BOARD_STATES=1,2,3,4,5
# DDM_LQ_CHYRON_LINES=FIRST LINE|SECOND LINE
# DDM_LQ_RACE_TZ=America/Chicago

# One log line per request (werkzeug) and per LED STATUS poll answer.
# DDM_ACCESS_LOG=1
